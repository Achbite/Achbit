# syntax=docker/dockerfile:1.7
# ====================================================================
# DeepCode 开发容器（Dockerfile.dev）
# 用途：作为 `make shell` 的开发壳子；常驻运行，反复 exec 进入。
# 包含统一 Kernel 开发工具链：Rust + Node 22 + pnpm + Linux/Windows 交叉编译基础工具。
# ====================================================================

ARG DEEPCODE_RUST_VERSION=1.88
FROM rust:${DEEPCODE_RUST_VERSION}-bookworm

ARG DEEPCODE_APT_MIRROR=https://deb.debian.org/debian
ARG DEEPCODE_APT_SECURITY_MIRROR=https://deb.debian.org/debian-security
ARG DEEPCODE_NODE_VERSION=22.22.3
ARG DEEPCODE_NODE_DIST_BASE=https://npmmirror.com/mirrors/node

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PNPM_HOME=/root/.local/share/pnpm \
    SCCACHE_DIR=/workspace/.build-cache/sccache \
    PATH=/root/.local/share/pnpm:/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ---- 1. 系统依赖 ----
# - 基础工具：curl/git/build-essential/pkg-config
# - Windows 交叉编译基础：gcc-mingw-w64-x86-64 + binutils-mingw-w64
# - 健康检查辅助：iputils-ping / netcat-openbsd / jq
# - Tauri thin shell 静态检查/打包准备：WebKitGTK、AppIndicator、SVG、patchelf
# - sccache：由 build.sh 按需启用，DEEPCODE_DISABLE_SCCACHE=1 可关闭
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    sed -i \
        -e "s#http://deb.debian.org/debian-security#${DEEPCODE_APT_SECURITY_MIRROR}#g" \
        -e "s#http://deb.debian.org/debian#${DEEPCODE_APT_MIRROR}#g" \
        /etc/apt/sources.list.d/debian.sources \
 && printf 'Acquire::Retries "2";\nAcquire::http::Timeout "30";\nAcquire::https::Timeout "30";\n' > /etc/apt/apt.conf.d/99deepcode-timeouts \
 && apt-get update && apt-get install -y --no-install-recommends \
        curl wget ca-certificates git \
        build-essential pkg-config make file bubblewrap \
        libssl-dev libasound2-dev \
        libwebkit2gtk-4.1-dev libayatana-appindicator3-dev librsvg2-dev librsvg2-bin patchelf \
        gcc-mingw-w64-x86-64 g++-mingw-w64-x86-64 binutils-mingw-w64-x86-64 nsis \
        iputils-ping netcat-openbsd jq xz-utils unzip sccache

# ---- 2. Node.js 22 LTS ----
# Use the official binary tarball instead of NodeSource apt, so the build is
# not blocked by a single external Debian repository path.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
        amd64) node_arch="x64" ;; \
        arm64) node_arch="arm64" ;; \
        *) echo "unsupported Node.js architecture: $arch" >&2; exit 1 ;; \
    esac; \
    node_pkg="node-v${DEEPCODE_NODE_VERSION}-linux-${node_arch}.tar.xz"; \
    curl -fsSL "${DEEPCODE_NODE_DIST_BASE}/v${DEEPCODE_NODE_VERSION}/${node_pkg}" -o "/tmp/${node_pkg}"; \
    tar -xJf "/tmp/${node_pkg}" -C /usr/local --strip-components=1; \
    rm -f "/tmp/${node_pkg}"; \
    win_node_pkg="node-v${DEEPCODE_NODE_VERSION}-win-x64.zip"; \
    curl -fsSL "${DEEPCODE_NODE_DIST_BASE}/v${DEEPCODE_NODE_VERSION}/${win_node_pkg}" -o "/tmp/${win_node_pkg}"; \
    rm -rf /tmp/deepcode-node-win64 /opt/deepcode-node-win64; \
    mkdir -p /tmp/deepcode-node-win64 /opt/deepcode-node-win64; \
    unzip -q "/tmp/${win_node_pkg}" -d /tmp/deepcode-node-win64; \
    install -m 644 "/tmp/deepcode-node-win64/node-v${DEEPCODE_NODE_VERSION}-win-x64/node.exe" /opt/deepcode-node-win64/node.exe; \
    rm -rf "/tmp/${win_node_pkg}" /tmp/deepcode-node-win64; \
    node --version; \
    npm --version; \
    test -f /opt/deepcode-node-win64/node.exe

# ---- 3. pnpm ----
# 通过 corepack 启用，避免全局 npm install 污染；registry 可覆盖以适配不同网络。
ARG DEEPCODE_NPM_REGISTRY=https://registry.npmmirror.com
RUN npm config set registry "${DEEPCODE_NPM_REGISTRY}" \
 && env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
        COREPACK_NPM_REGISTRY="${DEEPCODE_NPM_REGISTRY}" \
        corepack enable \
 && env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
        COREPACK_NPM_REGISTRY="${DEEPCODE_NPM_REGISTRY}" \
        corepack prepare pnpm@9.12.0 --activate \
 && mkdir -p $PNPM_HOME && pnpm --version

# ---- 4. Rust Windows 交叉目标 ----
# 让 Rust 支持 x86_64-pc-windows-gnu，配合 mingw-w64 工具链产出 Windows 二进制
ARG DEEPCODE_RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static
ARG DEEPCODE_RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup
ENV RUSTUP_DIST_SERVER=${DEEPCODE_RUSTUP_DIST_SERVER} \
    RUSTUP_UPDATE_ROOT=${DEEPCODE_RUSTUP_UPDATE_ROOT}
RUN --mount=type=cache,target=/usr/local/rustup/downloads,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
        rustup target add x86_64-pc-windows-gnu \
 && env -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u http_proxy -u https_proxy -u all_proxy \
        rustup component add rustfmt clippy

# ---- 5. 入口脚本 ----
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk
ENV PNPM_STORE_DIR=/root/.local/share/pnpm/store \
    DEEPCODE_WINDOWS_NODE_BIN=/opt/deepcode-node-win64/node.exe \
    DEEPCODE_NODE_LICENSE=/usr/local/LICENSE

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace

# 默认前台保活；Makefile 通过 docker exec 进入交互式 bash
CMD ["/usr/local/bin/entrypoint.sh"]
