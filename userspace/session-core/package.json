    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deepcode/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "ajv": "^8",
    "typescript": "^5.7.0"
  }
}
