{
  "name": "@deepcode/client",
  "version": "0.6.50",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.deepcode-gui.config.ts",
    "build": "pnpm typecheck && pnpm build:web",
    "build:web": "vite build --config vite.deepcode-gui.config.ts && mv dist-deepcode-gui/deepcode-gui.html dist-deepcode-gui/index.html",
    "typecheck": "tsc --noEmit",
    "typecheck:manual": "tsc --noEmit -p tsconfig.manual.json",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.5",
    "@codemirror/view": "6.43.12",
    "@deepcode/presentation-core": "workspace:*",
    "@deepcode/protocol": "workspace:*",
    "@headless-tree/core": "1.7.0",
    "@headless-tree/react": "1.7.0",
    "@lezer/highlight": "1.2.3",
    "@tauri-apps/plugin-dialog": "^2",
    "diff": "8.0.2",
    "eventsource-parser": "4.1.1",
    "hast-util-to-jsx-runtime": "2.3.6",
    "katex": "^0.17.0",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/hast": "3.0.4",
    "@types/mdast": "4.0.4",
    "@types/node": "^22.19.19",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
