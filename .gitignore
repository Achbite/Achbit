# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Build outputs
**/dist/
**/dist-*/
**/build/
target/
**/target/
**/src-tauri/gen/
**/.next/
**/.turbo/
**/.vite/
.build-cache/
.pnpm-store/
.achbit/build-baselines/
.achbit-recovery.*/

# Python bytecode
__pycache__/
*.py[cod]

# Local distribution packages
# bin/ holds generated distribution directories and binaries.
bin/*
!bin/.gitkeep

# Logs
.logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Environment and credentials
.env
.env.*
!.env.example
.achbit-worktree.mk

# Editor and system files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Project temporary files
_check_output.txt
_agent_tmp_*
*.tsbuildinfo
.achbit-preview-config*/
.deepcode-preview-config*/
# Product documentation excludes local engineering notes, task receipts and preview output.
/docs/architecture/
/docs/task-receipts/
/docs/tcr/
/.task-artifacts/

# Root Rust kernel workspace is library-only during the skeleton stage.
/Cargo.lock

# Default workspace runtime data
# Uncomment the following rule to exclude user data within workspace/.
# workspace/**
# Retain the workspace placeholder.
!workspace/.gitkeep
