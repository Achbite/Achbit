{
  "name": "achbit",
  "version": "0.6.65",
  "license": "MIT",
  "private": true,
  "description": "Achbit - 本地优先的 AI 编程工作台",
  "scripts": {
    "dev": "pnpm tauri:dev:achbit-gui",
    "dev:achbit-gui": "pnpm tauri:dev:achbit-gui",
    "dev:achbit-gui:web": "bash scripts/dev-achbit-gui-web.sh",
    "dev:kernel:build-only": "cargo build -p achbit-first-party-tools -p achbit-kernel-daemon -p achbit-host-web",
    "tauri:dev:achbit-gui": "bash scripts/dev-achbit-gui.sh",
    "build": "bash ./build.sh",
    "package": "bash ./build.sh --stage package",
    "build:ui": "bash ./build.sh --stage ui",
    "build:kernel": "bash ./build.sh --stage daemon",
    "start": "pnpm tauri:dev:achbit-gui",
    "typecheck": "pnpm --filter @achbit/protocol typecheck && pnpm --filter @achbit/session-core typecheck && pnpm --filter @achbit/client typecheck",
    "build:userspace-shared": "pnpm --filter @achbit/protocol build && pnpm --filter @achbit/session-core build",
    "build:gui-native": "bash ./build.sh --stage native-gui"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
