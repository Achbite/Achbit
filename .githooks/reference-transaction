#!/usr/bin/env bash
# managed-by: achbit-branch-flow
# Prevent deletion of the permanent local integration and release refs.
set -euo pipefail

state="${1:-}"
[ "$state" = 'prepared' ] || exit 0

while read -r old_oid new_oid ref_name; do
  case "$ref_name" in
    refs/heads/main|refs/heads/dev-main)
      if [[ "$new_oid" =~ ^0+$ ]]; then
        printf 'Achbit protected branch cannot be deleted locally: %s\n' "$ref_name" >&2
        exit 1
      fi
      ;;
  esac
done
