{
  "schemaVersion": "deepcode.first-party-plugin.v1",
  "id": "github",
  "uri": "plugin://github@first-party",
  "displayName": "GitHub",
  "shortDescription": "查找仓库、阅读代码和议题。",
  "activationMediaTypes": [],
  "providerRef": "tool-provider:first-party:github",
  "capabilityRefs": [
    "github:search",
    "github:contents-read"
  ],
  "capabilitySummary": "Provides source-native GitHub repository, code, and issue search plus repository contents reads.",
  "tools": [
    {
      "remoteName": "search",
      "canonicalName": "github.search",
      "description": "Search GitHub repositories, code, or issues with GitHub's native Search API.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "repositories",
              "code",
              "issues"
            ],
            "default": "repositories"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "effect": "networkRead",
      "logicalTarget": "https://api.github.com",
      "binding": {
        "kind": "none"
      },
      "toolContributionRef": "tool-contribution:first-party:github.search",
      "promptContribution": {
        "contributionRef": "tool-prompt-contribution:first-party:github.search",
        "promptSnippet": "Search GitHub repositories, code, and issues through GitHub's native API.",
        "usageGuidelines": [
          "Use this for GitHub-specific discovery instead of routing GitHub queries through the general web search tool.",
          "Code search requires the GitHub token exposed to the selected plugin process."
        ]
      }
    },
    {
      "remoteName": "read",
      "canonicalName": "github.read",
      "description": "Read a GitHub repository directory listing or UTF-8 file through the Contents API.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 3,
            "description": "Repository in owner/name form."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "default": "."
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 262144,
            "default": 262144
          }
        },
        "required": [
          "repository"
        ],
        "additionalProperties": false
      },
      "effect": "networkRead",
      "logicalTarget": "https://api.github.com",
      "binding": {
        "kind": "none"
      },
      "toolContributionRef": "tool-contribution:first-party:github.read",
      "promptContribution": {
        "contributionRef": "tool-prompt-contribution:first-party:github.read",
        "promptSnippet": "Read a repository directory or UTF-8 file through GitHub's native Contents API.",
        "usageGuidelines": [
          "Use the repository and path returned by GitHub search when source contents are needed."
        ]
      }
    }
  ]
}
