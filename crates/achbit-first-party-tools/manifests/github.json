{
  "schemaVersion": "achbit.first-party-plugin.v1",
  "id": "github",
  "uri": "plugin://github@first-party",
  "displayName": "GitHub",
  "shortDescription": "读取 GitHub 仓库、Issue 和 PR 链接，搜索仓库与代码。",
  "activationMediaTypes": [],
  "providerRef": "tool-provider:first-party:github",
  "capabilityRefs": [
    "github:search",
    "github:contents-read",
    "github:issue-read",
    "github:pull-request-read"
  ],
  "capabilitySummary": "Read GitHub repository, issue and pull request links, discussions, reviews, changed files and repository contents through the official API. Search GitHub repositories, code and issues.",
  "tools": [
    {
      "remoteName": "search",
      "canonicalName": "github.search",
      "description": "Search GitHub repositories, code, or issues with GitHub's native Search API.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "repositories",
              "code",
              "issues"
            ],
            "default": "repositories"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 10
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "effect": "networkRead",
      "logicalTarget": "https://api.github.com",
      "binding": {
        "kind": "none"
      },
      "toolContributionRef": "tool-contribution:first-party:github.search",
      "promptContribution": {
        "contributionRef": "tool-prompt-contribution:first-party:github.search",
        "promptSnippet": "Search GitHub repositories, code, and issues through GitHub's native API.",
        "usageGuidelines": [
          "Use this for GitHub-specific discovery instead of routing GitHub queries through the general web search tool.",
          "Code search requires a connected GitHub account."
        ]
      }
    },
    {
      "remoteName": "read",
      "canonicalName": "github.read",
      "description": "Read a github.com repository, Issue or PR URL. Select a part for discussion, changed files or reviews. With repository/path/ref, read a directory or a UTF-8 file.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 3,
            "description": "Repository in owner/name form."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "default": "."
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 262144,
            "default": 262144
          },
          "url": {
            "type": "string",
            "description": "HTTPS github.com repository, issue or pull request URL."
          },
          "part": {
            "type": "string",
            "enum": [
              "overview",
              "files",
              "comments",
              "reviews",
              "reviewComments"
            ]
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "additionalProperties": false
      },
      "effect": "networkRead",
      "logicalTarget": "https://api.github.com",
      "binding": {
        "kind": "none"
      },
      "toolContributionRef": "tool-contribution:first-party:github.read",
      "promptContribution": {
        "contributionRef": "tool-prompt-contribution:first-party:github.read",
        "promptSnippet": "Read a GitHub repository, issue, or pull request link through the official API.",
        "usageGuidelines": [
          "Use url for a GitHub link, or repository with optional path and ref for contents. Read the overview first. Follow nextPage for additional discussion, reviews or changed files."
        ]
      }
    }
  ]
}
