{
  "schemaVersion": "achbit.first-party-plugin.v1",
  "id": "arxiv",
  "uri": "plugin://arxiv@first-party",
  "displayName": "arXiv",
  "shortDescription": "搜索 arXiv 论文，按章节或页码阅读原文。",
  "activationMediaTypes": [],
  "providerRef": "tool-provider:first-party:arxiv",
  "capabilityRefs": [
    "arxiv:metadata-search",
    "arxiv:paper-read",
    "arxiv:full-text-read"
  ],
  "capabilitySummary": "Search arXiv papers by topic, author, category and date. Read paper metadata or versioned full text with sections, pages and source citations.",
  "tools": [
    {
      "remoteName": "search",
      "canonicalName": "arxiv.search",
      "description": "Search arXiv paper metadata through the arXiv Atom API.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Search expression passed to arXiv with the selected field prefix. Include double quotes around a phrase when phrase matching is intended."
          },
          "field": {
            "type": "string",
            "enum": [
              "all",
              "title",
              "author",
              "abstract",
              "category",
              "id"
            ],
            "default": "all"
          },
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "default": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30,
            "default": 10
          },
          "sortBy": {
            "type": "string",
            "enum": [
              "relevance",
              "lastUpdatedDate",
              "submittedDate"
            ],
            "default": "relevance"
          },
          "sortOrder": {
            "type": "string",
            "enum": [
              "ascending",
              "descending"
            ],
            "default": "descending"
          },
          "author": {
            "type": "string",
            "description": "Author name or phrase."
          },
          "category": {
            "type": "string",
            "description": "A single category, for example cs.LG."
          },
          "submittedFrom": {
            "type": "string",
            "description": "Inclusive submission date in YYYY-MM-DD format."
          },
          "submittedTo": {
            "type": "string",
            "description": "Inclusive submission date in YYYY-MM-DD format."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "effect": "networkRead",
      "logicalTarget": "https://export.arxiv.org/api",
      "binding": {
        "kind": "none"
      },
      "toolContributionRef": "tool-contribution:first-party:arxiv.search",
      "promptContribution": {
        "contributionRef": "tool-prompt-contribution:first-party:arxiv.search",
        "promptSnippet": "Search arXiv paper metadata through its native Atom API.",
        "usageGuidelines": [
          "Use this for arXiv discovery instead of routing arXiv queries through the general web search tool."
        ]
      }
    },
    {
      "remoteName": "read",
      "canonicalName": "arxiv.read",
      "description": "Read paper metadata or full text from an arXiv ID, abstract, HTML or PDF link. Full text uses official HTML sections or text extracted from PDF pages. Use next for a version-pinned continuation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Modern or archive-style arXiv ID, optionally versioned, or an official paper link."
          },
          "view": {
            "type": "string",
            "enum": [
              "metadata",
              "fullText"
            ],
            "default": "metadata"
          },
          "section": {
            "type": "integer",
            "minimum": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "UTF-8 byte position from a continuation."
          },
          "maxBytes": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 131072
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "effect": "networkRead",
      "logicalTarget": "https://export.arxiv.org/api",
      "binding": {
        "kind": "none"
      },
      "toolContributionRef": "tool-contribution:first-party:arxiv.read",
      "promptContribution": {
        "contributionRef": "tool-prompt-contribution:first-party:arxiv.read",
        "promptSnippet": "Read arXiv metadata, HTML sections or PDF pages.",
        "usageGuidelines": [
          "Use view=fullText for questions about methods, evidence and results. Pick a section from the table of contents or a PDF page, and follow next for remaining text. Cite the returned location and versioned source URL."
        ]
      }
    }
  ]
}
